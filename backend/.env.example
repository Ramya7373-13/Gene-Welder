# Database - Neon serverless PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mutationmechanic"

# Server
PORT=5000

# Frontend (for CORS)
FRONTEND_URL=http://localhost:3001

# AI Integration Keys
GEMINI_API_KEY=your_gemini_api_key_here
ALPHAGENOME_API_KEY=your_alphagenome_api_key_here
ALPHAFOLD_API_URL=https://api.esmatlas.com/foldSequence/v1/pdb/
XAI_API_KEY=your_xai_api_key_here
GROK_MODEL=grok-4.6
GROK_MODEL_IMAGE=grok-imagine-image
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# SpliceAI local CLI integration
SPLICEAI_BIN=spliceai
SPLICEAI_REFERENCE=
SPLICEAI_ANNOTATION=grch38

# Session secret for authentication
SESSION_SECRET=your_session_secret_here

# Resend (Magic-link email)
RESEND_API_KEY=your_resend_api_key_here

# Stripe (Subscriptions)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_ID=your_stripe_price_id_here
