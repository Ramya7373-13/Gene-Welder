# Database - Neon serverless PostgreSQL
# For local dev: postgresql://username:password@localhost:5432/mutationmechanic
# For Neon: postgresql://username:password@ep-xxx-xxx-123456.us-east-2.aws.neon.tech/mutationmechanic?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/mutationmechanic"

# Direct URL for migrations (Neon uses the same URL but prisma migrate deploy needs it)
# Only needed if using separate pooler and direct connections
# DIRECT_URL="${DATABASE_URL}"

# Server
PORT=5000

# Frontend (for CORS) - set to your production URL in production
FRONTEND_URL=http://localhost:3001

# Server-only integrations. Never prefix these with VITE_.
# Keys prefixed with VITE_ are exposed to browsers via the frontend build.
# Keep all secrets (API keys, database URLs) in this backend .env only.
GEMINI_API_KEY=REPLACE_WITH_REAL_KEY
ALPHAGENOME_API_KEY=REPLACE_WITH_REAL_KEY
ALPHAFOLD_API_URL=https://api.esmatlas.com/foldSequence/v1/pdb/
XAI_API_KEY=REPLACE_WITH_REAL_KEY
GROK_MODEL=grok-4.6
GROK_MODEL_IMAGE=grok-imagine-image
PERPLEXITY_API_KEY=REPLACE_WITH_REAL_KEY

# SpliceAI local CLI integration. Requires the official spliceai package,
# model weights, and a matching GRCh37/GRCh38 reference FASTA.
SPLICEAI_BIN=spliceai
SPLICEAI_REFERENCE=
SPLICEAI_ANNOTATION=grch38

# Session secret for future authentication (M1)
# Generate with: openssl rand -base64 32
# DO NOT use this placeholder in production - generate a real secret
SESSION_SECRET=REPLACE_WITH_REAL_SECRET